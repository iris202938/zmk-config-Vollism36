#include "Vollism36.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/input/input-event-codes.h>
#include <input/processors/sensor_rotation.dtsi>
#include <input/processors/zmk-input-processor-keybind.dtsi>
// #include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/naginata.dtsi>

#define QWE 0
#define NGN 1
#define CAD 2
#define WIN 3
#define LWR 4
#define RSE 5
#define ADJ 6
#define MOV 7
#define NUM 8
#define BLE 9

&kscan0 {
        col-gpios
            = <&xiao_d 10 GPIO_ACTIVE_HIGH>
            , <&xiao_d 9 GPIO_ACTIVE_HIGH> 
            , <&xiao_d 8 GPIO_ACTIVE_HIGH> 
            , <&xiao_d 7 GPIO_ACTIVE_HIGH>
            ;
};
/ {
    /* 既存のリスナーを一旦無効化するか、完全に上書きします */
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        status = "okay"; // 明示的に有効化

        /* 【1】方向キー（WINレイヤー）: 最優先 */
        arrows {
            layers = <WIN>; 
            input-processors = <&sensor_rotation>, <&xy_to_keys>;
        };

        /* 【2】スクロール（RSEレイヤー） */
        scroll {
            layers = <RSE>;
            input-processors = <&sensor_rotation>,
                               <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>,
                               <&zip_xy_scaler 1 30>,
                               <&zip_xy_to_scroll_mapper>;
        };

        /* 【3】90度回転ベースレイヤー */
        rot90 {
            layers = <ROT90>; // 90度用のベースレイヤー
            input-processors = <&sensor_rotation>, <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT)>;
        };

        /* 【4】デフォルト（0度）: どの条件にも当てはまらない時 */
        /* 指定レイヤーを「これ以外」にするのではなく、基本レイヤーのみを指定します */
        default_mmv {
            layers = <QWE NGN CAD>; 
            input-processors = <&sensor_rotation>;
        };
    };

    /* ここが「input_processors」という箱です */
    input_processors {
        /* 基本の345度補正 */
        sensor_rotation: sensor_rotation {
            compatible = "zmk,input-processor-sensor-rotation";
            #input-processor-cells = <0>;
            rotation-angle = <345>;
        };

        /* 各回転用のトランスフォーム（sensor_rotationの後に連結して使う） */
        rot_90_tf: rot_90_tf {
            compatible = "zmk,input-processor-transform";
            #input-processor-cells = <0>;
            type = <INPUT_EV_REL>;
            x-codes = <INPUT_REL_X>, <INPUT_REL_Y>;
            y-codes = <INPUT_REL_Y>, <INPUT_REL_X>;
            /* 90度: XとYを入れ替えてYを反転 */
            map = <INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT>;
        };

        /* 方向キー変換 */
        xy_to_keys: xy_to_keys {
            compatible = "zmk,input-processor-keybind";
            #input-processor-cells = <0>;
            bindings = <&kp RIGHT>, <&kp LEFT>, <&kp UP>, <&kp DOWN>;
            threshold = <100>; 
        };
    };
}; /* ここでルート（ / ）を閉じます。 */

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        evt-type = <INPUT_EV_REL>; // あるいは <INPUT_EV_ABS>
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <600>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
    };
};
