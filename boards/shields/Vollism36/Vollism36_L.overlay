#include "Vollism36.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/input/input-event-codes.h>
#include <input/processors/sensor_rotation.dtsi>
#include <input/processors/zmk-input-processor-keybind.dtsi>

#define QWE 0
#define WIN 1
#define CAD 2
#define LWR 3
#define RSE 4
#define ADJ 5
#define MOV 6
#define NUM 7
#define BLE 8

&kscan0 {
        col-gpios
            = <&xiao_d 10 GPIO_ACTIVE_HIGH>
            , <&xiao_d 9 GPIO_ACTIVE_HIGH> 
            , <&xiao_d 8 GPIO_ACTIVE_HIGH> 
            , <&xiao_d 7 GPIO_ACTIVE_HIGH>
            ;
};

// &trackball_listener のオーバーレイはコメントアウトのまま

/ {
    // ⬇️ すべてのカスタムノード定義をこのルートブロック内に統合
    
    // 1. trackball_listener ノードの定義
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        input-processors = <&sensor_rotation>;
        // automouse { ... }
        // scroll {
        //         layers = <RSE>;
        //         input-processors = <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>
        //                          , <&zip_xy_scaler 1 30>
        //                          , <&zip_xy_to_scroll_mapper>;
        // };
    };

    // 2. zip_keybind_arrows ノードの定義
    zip_keybind_arrows: zip_keybind_arrows {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        bindings = <&kp RIGHT>,
                    <&kp LEFT>,
                    <&kp DOWN>,
                    <&kp UP>;
        tick = <10>;
        wait-ms = <0>;
        tap-ms = <50>;
        threshold = <2>;
        mode = <2>;
        continuous_key_press;
    };
    
    // 3. input_processors ノード（sensor_rotation を含む）の定義
    input_processors {
        sensor_rotation: sensor_rotation {
            compatible = "zmk,input-processor-sensor-rotation";
            #input-processor-cells = <0>;
            rotation-angle = <340>;
        };
    };

}; // ⬆️ すべての定義を終えて、ルートノードを閉じる

&joystick_listener {
		status = "okay";
		r_layer13 {
			layers = <NUM>; // レイヤー13がアクティブな場合
			input-processors = <&zip_keybind_arrows>; // zip_keybind_arrows を使用
			process-next; // 他のプロセッサも処理を継続
		};
		r_layer13-prevent {
			layers = <NUM>; // レイヤー13がアクティブな場合
			input-processors = <&zip_xy_scaler 0 1>; // ジョイスティックの動きをゼロにスケーリング（無効化）
		};
		r_mouse_speed_full {
			layers = <ADJ>; // レイヤー9がアクティブな場合
			input-processors = <&zip_xy_transform (0)> // 変換なし (Y軸反転を無効化)
							, <&zip_xy_scaler 80 100>; // 速度を80/100に設定 (乗数80, 除数100)
		};
		r_scroll {
			layers = <LWR>; // レイヤー5がアクティブな場合
			input-processors = <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>
							, <&zip_xy_scaler 10 100> // スケーリング（10/100）
							, <&zip_xy_to_scroll_mapper>; // スクロールイベントにマッピング
		};
		r_layer4 {
			layers = <WIN>; // レイヤー4がアクティブな場合
			input-processors = <&zip_keybind_keys_directionH>; // zip_keybind_keys_directionH を使用
			process-next;
		};
		r_layer4-prevent {
			layers = <WIN>; // レイヤー4がアクティブな場合
			input-processors = <&zip_xy_scaler 0 1>; // ジョイスティックの動きをゼロにスケーリング（無効化）
		};
		r_default {
			layers = <QWE>; // レイヤー0（デフォルト）がアクティブな場合
			input-processors = <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>
							, <&zip_xy_scaler 8 100> // スケーリング（8/100）
							, <&zip_xy_to_scroll_mapper>; // スクロールイベントにマッピング
		};
};

// --- 既存の &pinctrl と &spi0 ブロックはそのまま継続 ---

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        evt-type = <INPUT_EV_REL>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <600>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;

        arrows {
                layers = <NUM>;
                bindings =
                    <&kp RIGHT_ARROW>, // トラックボールのX+ (右)
                    <&kp LEFT_ARROW>,  // トラックボールのX- (左)
                    <&kp UP_ARROW>,    // トラックボールのY+ (上)
                    <&kp DOWN_ARROW>;  // トラックボールのY- (下)

                // この設定はZMKのデフォルト設定に依存しますが、以前のコメントを参考にそのまま残します
                tick = <10>;
                wait-ms = <0>;
                tap-ms = <10>;
        };
    };
};