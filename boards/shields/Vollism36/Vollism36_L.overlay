#include "Vollism36.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/input/input-event-codes.h>
#include <input/processors/sensor_rotation.dtsi>
#include <input/processors/zmk-input-processor-keybind.dtsi>
// #include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/naginata.dtsi>

#define QWE 0
#define NGN 1
#define NIC 2
#define LIN 3
#define NGNL 4
#define NICL 5
#define CAD 6
#define WIN 7
#define LWR 8
#define LWRL 9
#define LWRW 10
#define RSE 11
#define RSEL 12
#define RSEW 13
#define ADJ 14
#define ADJL 15
#define ADJW 16
#define MOV 17
#define MOVL 18
#define MOVW 19
#define NUM 20
#define BLE 21

/ {
    /* 既存の定義（input_processorsなど）と同じ階層に追加 */
    aliases {
        led-red = &led0;   /* Xiao BLE の赤色LEDラベル */
        led-green = &led1; /* Xiao BLE の緑色LEDラベル */
        led-blue = &led2;  /* Xiao BLE の青色LEDラベル */
    };
};


&kscan0 {
        col-gpios
            = <&xiao_d 10 GPIO_ACTIVE_HIGH>
            , <&xiao_d 9 GPIO_ACTIVE_HIGH> 
            , <&xiao_d 8 GPIO_ACTIVE_HIGH> 
            , <&xiao_d 7 GPIO_ACTIVE_HIGH>
            ;
};

/ {
    input_processors {
        sensor_rotation: sensor_rotation {
            compatible = "zmk,input-processor-sensor-rotation";
            #input-processor-cells = <0>;
            rotation-angle = <255>;
        };

        xy_to_keys: xy_to_keys {
            compatible = "zmk,input-processor-keybind";
            #input-processor-cells = <0>;
            bindings = <&kp RIGHT>, <&kp LEFT>, <&kp UP>, <&kp DOWN>;
            threshold = <3>; // 方向キーが勝手に入る場合はしきい値を少し上げる
            mode = <1>;
            tick = <50>; // ティック間隔
			wait-ms = <0>; // 待機時間
			tap-ms = <50>; // タップ時間
        };
    };

    trackball_listener_local {
        compatible = "zmk,input-listener";
        device = <&trackball>;

        /* ==========================================================
        Layer 21: BLE (通常マウス)
        ========================================================== */
        l_ble {
            layers = <BLE>;
            input-processors = <&sensor_rotation>;
        };

        /* ==========================================================
        Layer 20: NUM (通常マウス)
        ========================================================== */
        l_num {
            layers = <NUM>;
            input-processors = <&sensor_rotation>;
        };

        /* ==========================================================
        Layer 19: MOVW (方向キー変換)
        ========================================================== */
        l_mov {
            layers = <MOVW>; 
            input-processors = 
                <&sensor_rotation>, 
                <&zip_xy_scaler 200 100>, 
                <&xy_to_keys>;
            process-next;
        };

        l_mov_prevent {
            layers = <MOVW>;
            input-processors = <&zip_xy_scaler 0 1>;
        };

        /* ==========================================================
        Layer 18: MOVL (方向キー変換)
        ========================================================== */
        l_mov {
            layers = <MOVL>; 
            input-processors = 
                <&sensor_rotation>, 
                <&zip_xy_scaler 200 100>, 
                <&xy_to_keys>;
            process-next;
        };

        l_mov_prevent {
            layers = <MOVL>;
            input-processors = <&zip_xy_scaler 0 1>;
        };

        /* ==========================================================
        Layer 17: MOV (方向キー変換)
        ========================================================== */
        l_mov {
            layers = <MOV>; 
            input-processors = 
                <&sensor_rotation>, 
                <&zip_xy_scaler 200 100>, 
                <&xy_to_keys>;
            process-next;
        };

        l_mov_prevent {
            layers = <MOV>;
            input-processors = <&zip_xy_scaler 0 1>;
        };

        /* ==========================================================
        Layer 16: ADJW (通常マウス)
        ========================================================== */
        l_adjw {
            layers = <ADJW>;
            input-processors = <&sensor_rotation>;
        };

        /* ==========================================================
        Layer 15: ADJL (通常マウス)
        ========================================================== */
        l_adjl {
            layers = <ADJL>;
            input-processors = <&sensor_rotation>;
        };

        /* ==========================================================
        Layer 14: ADJ (通常マウス)
        ========================================================== */
        l_adj {
            layers = <ADJ>;
            input-processors = <&sensor_rotation>;
        };

        /* ==========================================================
        Layer 13: RSEW (スクロール)
        ========================================================== */
        l_rsew {
            layers = <RSEW>;
            input-processors = 
                <&sensor_rotation>,
                <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>,
                <&zip_xy_scaler 1 30>,
                <&zip_xy_to_scroll_mapper>,
                <&zip_xy_scaler 0 1>; 
        };

        /* ==========================================================
        Layer 12: RSEL (スクロール)
        ========================================================== */
        l_rsel {
            layers = <RSEL>;
            input-processors = 
                <&sensor_rotation>,
                <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>,
                <&zip_xy_scaler 1 30>,
                <&zip_xy_to_scroll_mapper>,
                <&zip_xy_scaler 0 1>; 
        };

        /* ==========================================================
        Layer 11: RSE (スクロール)
        ========================================================== */
        l_rse {
            layers = <RSE>;
            input-processors = 
                <&sensor_rotation>,
                <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>,
                <&zip_xy_scaler 1 30>,
                <&zip_xy_to_scroll_mapper>,
                <&zip_xy_scaler 0 1>; 
        };

        /* ==========================================================
        Layer 10: LWRW (通常マウス)
        ========================================================== */
        l_lwrw {
            layers = <LWRW>;
            input-processors = <&sensor_rotation>;
        };

        /* ==========================================================
        Layer 9: LWRL (通常マウス)
        ========================================================== */
        l_lwrl {
            layers = <LWRL>;
            input-processors = <&sensor_rotation>;
        };

        /* ==========================================================
        Layer 8: LWR (通常マウス)
        ========================================================== */
        l_lwr {
            layers = <LWR>;
            input-processors = <&sensor_rotation>;
        };

        /* ==========================================================
        Layer 7: WIN (方向キー変換)
        ========================================================== */
        l_win {
            layers = <WIN>; 
            input-processors = 
                <&sensor_rotation>, 
                <&zip_xy_scaler 200 100>, 
                <&xy_to_keys>;
            process-next;
        };

        l_win_prevent {
            layers = <WIN>;
            input-processors = <&zip_xy_scaler 0 1>;
        };

        /* ==========================================================
        Layer 6: CAD (通常マウス)
        ========================================================== */
        l_cad {
            layers = <CAD>;
            input-processors = <&sensor_rotation>;
        };

        /* ==========================================================
        Layer 5: NICL (通常マウス)
        ========================================================== */
        l_nicl {
            layers = <NICL>;
            input-processors = <&sensor_rotation>;
        };

        /* ==========================================================
        Layer 4: NGNL (通常マウス)
        ========================================================== */
        l_ngnl {
            layers = <NGNL>;
            input-processors = <&sensor_rotation>;
        };

        /* ==========================================================
        Layer 3: LIN (通常マウス)
        ========================================================== */
        l_lin {
            layers = <LIN>;
            input-processors = <&sensor_rotation>;
        };

        /* ==========================================================
        Layer 2: NIC (通常マウス)
        ========================================================== */
        l_nic {
            layers = <NIC>;
            input-processors = <&sensor_rotation>;
        };

        /* ==========================================================
        Layer 1: NGN (通常マウス)
        ========================================================== */
        l_ngn {
            layers = <NGN>;
            input-processors = <&sensor_rotation>;
        };

        /* ==========================================================
        Layer 0: QWE (通常マウス)
        ========================================================== */
        l_qwe {
            layers = <QWE>;
            input-processors = <&sensor_rotation>;
        };
    };
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        // evt-type = <INPUT_EV_REL>; // あるいは <INPUT_EV_ABS>
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        // cpi = <600>;
        // evt-type = <INPUT_EV_REL>;
        // x-input-code = <INPUT_REL_X>;
        // y-input-code = <INPUT_REL_Y>;
    };
};
