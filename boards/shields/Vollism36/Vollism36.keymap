            //     layers = <QWE MOV CAD>;
            //     timeout-ms = <80>;
            // };
            wind_l {
                bindings = <&win_left>;
                key-positions = <11 12>;
                layers = <LWR LWRL LWRW>;
                timeout-ms = <80>;
            };
            wind_r {
                bindings = <&win_right>;
                key-positions = <12 13>;
                layers = <LWR LWRL LWRW>;
                timeout-ms = <80>;
            };
