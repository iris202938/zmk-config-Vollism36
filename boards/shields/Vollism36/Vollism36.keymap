                bindings = <&kp KP_NLCK>;
                key-positions = <8 9>;
                layers = <NUM NUML NUMW>;
                timeout-ms = <80>;
            };
            dot_question {
                bindings = <&kp KP_DOT>;
                key-positions = <18 19>;
                layers = <NUM NUML NUMW>;
                timeout-ms = <80>;
