            combo_exl_fill { // Excelのオートフィル
                timeout-ms = <80>;
                key-positions = <2 7 11>; // E,I,Sのキー位置に書き換えてください
                layers = <QWE LIN CAD RSE RSEL RSEW>;
                bindings = <&exl_fill>;
            };
            combo_m_xl_rename { // Excelのシート名変更マクロ
                timeout-ms = <80>;
                key-positions = <15 8 3>; // H,O,Rのキー位置に書き換えてください
                layers = <QWE LIN CAD RSE RSEL RSEW>;
                bindings = <&m_xl_rename>;
            };
            combo_exl_group_close { // Excelのグループ化/閉じる
                timeout-ms = <80>;
                key-positions = <10 15>; // A,Hのキー位置に書き換えてください
                layers = <ADJL ADJW>;
                bindings = <&exl_group_close>;
            };
            combo_exl_group_open { // Excelのグループ化/開く
                timeout-ms = <80>;
                key-positions = <10 16>; // A,Jのキー位置に書き換えてください
                layers = <ADJL ADJW>;
                bindings = <&exl_group_open>;
            };
            combo_excel_move_row_cut { // Excelの行選択切取り
                timeout-ms = <80>;
                key-positions = <8 9>;
                layers = <MOVL MOVW>;
                bindings = <&excel_move_row_cut>;
            };
            combo_excel_move_row_copy { // Excelの行選択コピー
                timeout-ms = <80>;
                key-positions = <18 19>;
                layers = <MOVL MOVW>;
                bindings = <&excel_move_row_copy>;
            };
            combo_excel_move_row_paste { // Excelの行選択貼付
                timeout-ms = <80>;
                key-positions = <27 28>;
                layers = <MOVL MOVW>;
                bindings = <&excel_move_row_paste>;
            };
            combo_excel_line_erase { // Excelの罫線消去
                timeout-ms = <80>;
                key-positions = <20 21 22>; // Z,X,Cのキー位置に書き換えてください
                layers = <MOVL>;
                bindings = <&excel_line_erase>;
            };
            combo_excel_line_erase_p { // Excelの罫線消去(Pause Break)
                timeout-ms = <80>;
                key-positions = <20 21 22>; // Z,X,Cのキー位置に書き換えてください
                layers = <MOVW>;
                bindings = <&excel_line_erase_p>;
            };
            combo_excel_ruled_line_free_write { // Excelの罫線ペン
                timeout-ms = <80>;
                key-positions = <15 24 1>; // H,B,Wのキー位置に書き換えてください
                layers = <MOVL MOVW>;
                bindings = <&excel_ruled_line_free_write>;
            };
            combo_excel_ruled_line_free_erase { // Excelの罫線消しゴム
                timeout-ms = <80>;
                key-positions = <15 24 2>; // H,B,Eのキー位置に書き換えてください
                layers = <MOVL MOVW>;
                bindings = <&excel_ruled_line_free_erase>;
            };
            combo_excel_ruled_line_all_drawing { // Excelの罫線格子状
                timeout-ms = <80>;
                key-positions = <15 24 10>; // H,B,Aのキー位置に書き換えてください
                layers = <MOVL MOVW>;
                bindings = <&excel_ruled_line_all_drawing>;
            };
            combo_excel_ruled_line_fat_drawing { // Excelの罫線太い外枠
                timeout-ms = <80>;
                key-positions = <15 24 4>; // H,B,Tのキー位置に書き換えてください
                layers = <MOVL MOVW>;
                bindings = <&excel_ruled_line_fat_drawing>;
            };
