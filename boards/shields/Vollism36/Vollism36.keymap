        behaviors {
            macro_LANG1: macro_LANG1 {
                compatible = "zmk,behavior-macro";
                label = "macro_LANG1";
                #binding-cells = <0>;
                bindings = <&kp LANG1>, <&to NIC>;
            };
            macro_LANG2: macro_LANG2 {
                compatible = "zmk,behavior-macro";
                label = "macro_LANG2";
                #binding-cells = <0>;
                bindings = <&kp LANG2>, <&to QWE>;
            };
            macro_LANG1L: macro_LANG1L {
                compatible = "zmk,behavior-macro";
