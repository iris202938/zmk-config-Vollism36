            combo_esc_l {
                timeout-ms = <75>;
                layers = <QWE LIN MOV CAD ADJ ADJL ADJW NUM NUML NUMW>;
                key-positions = <0 10>; 
                bindings = <&kp ESC>;
            };
            combo_esc_r {
                timeout-ms = <75>;
                layers = <QWE LIN MOV CAD>;
                key-positions = <9 19>; 
                bindings = <&kp ESC>;
            };
            // tab {
            //     bindings = <&kp TAB>;
