        //         ;
        // };
        // mkp_aml: mkp_automosuelayer {
        //     compatible = "zmk,behavior-macro-one-param";
        //     #binding-cells = <1>;
        //     bindings
        //         = <&macro_param_1to1>
        //         , <&macro_press &mkp MACRO_PLACEHOLDER>
        //         , <&macro_pause_for_release>
        //         , <&macro_param_1to1>
        //         , <&macro_release &mkp MACRO_PLACEHOLDER>
