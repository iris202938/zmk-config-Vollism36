                #binding-cells = <0>;
                tapping-term-ms = <230>;
                bindings = <&all_ht X X>, <&ctrl_a_x>, <&ctrl_d_x>, <&ctrl_f_x>;
            };

            // --- Tap Dance Y ---
            td_Y: tap_dance_Y {
                compatible = "zmk,behavior-tap-dance";
                #binding-cells = <0>;
                tapping-term-ms = <230>;
                bindings = <&all_ht Y Y>, <&ctrl_a_y>, <&ctrl_d_y>, <&ctrl_f_y>;
            };

            // --- Tap Dance Z ---
            td_Z: tap_dance_Z {
                compatible = "zmk,behavior-tap-dance";
                #binding-cells = <0>;
                tapping-term-ms = <230>;
                bindings = <&all_ht LALT Z>, <&ctrl_a_z>, <&ctrl_d_z>, <&ctrl_f_z>;
            };

            // --- Tap Dance SEMICOLON ---
            td_SEMI: tap_dance_SEMI {
                compatible = "zmk,behavior-tap-dance";
                #binding-cells = <0>;
                tapping-term-ms = <230>;
                // 1-Tap: 通常キー, 2-Taps: 0.5mm , 3-Taps: 0.25mm
                bindings = <&all_ht RCTRL SEMI>, <&ctrl_alt_l>, <&ctrl_alt_semi>; 
            };

            // --- Tap Dance COMMA ---
            td_COMMA: tap_dance_COMMA {
                compatible = "zmk,behavior-tap-dance";
                #binding-cells = <0>;
                tapping-term-ms = <230>;
                // 1-Tap: 通常キー, 2-Taps: 銘板表編集 (Ctrl+F+c), 3-Taps:  銘板表 (Ctrl+F+d)
                bindings = <&all_ht COMMA COMMA>, <&ctrl_f_c>, <&ctrl_f_d>;
            };

            // --- Tap Dance DOT ---
            td_DOT: tap_dance_DOT {
                compatible = "zmk,behavior-tap-dance";
                #binding-cells = <0>;
                tapping-term-ms = <230>;
                // 1-Tap: 通常キー, 2-Taps: 部品表編集 (Ctrl+F+g), 3-Taps:  集計表 (Ctrl+F+h)
                bindings = <&all_ht DOT DOT>, <&ctrl_f_g>, <&ctrl_f_h>;
            };

            // --- Tap Dance SLASH ---
            td_SLASH: tap_dance_SLASH {
                compatible = "zmk,behavior-tap-dance";
                #binding-cells = <0>;
                tapping-term-ms = <230>;
                // 1-Tap: 通常キー, 2-Taps: 1G , 3-Taps: 1/4G
                bindings = <&all_ht RGUI SLASH>, <&ctrl_alt_j>, <&ctrl_alt_k>;
            };
        };

        macros {
            qmt: qwerty_mt {
                compatible = "zmk,behavior-macro-two-param";
                wait-ms = <0>;
                tap-ms = <0>;
                #binding-cells = <2>;
                bindings
                    = <&macro_press &mo WINS>
                    , <&macro_param_1to1>
                    , <&macro_param_2to2>
                    , <&macro_press &mt MACRO_PLACEHOLDER MACRO_PLACEHOLDER>
                    , <&macro_pause_for_release>
                    , <&macro_param_1to1>
                    , <&macro_param_2to2>
                    , <&macro_release &mt MACRO_PLACEHOLDER MACRO_PLACEHOLDER>
                    , <&macro_release &mo WINS>
                    ;
            };
            qm: qwerty_m {
                compatible = "zmk,behavior-macro-one-param";
                wait-ms = <0>;
                tap-ms = <0>;
                #binding-cells = <1>;
                bindings
                    = <&macro_press &mo WINS>
                    , <&macro_param_1to1>
                    , <&macro_press &kp MACRO_PLACEHOLDER>
                    , <&macro_pause_for_release>
                    , <&macro_param_1to1>
                    , <&macro_release &kp MACRO_PLACEHOLDER>
                    , <&macro_release &mo WINS>
                    ;
            };

            file_f: file_f { // ファイルの切り替え正
                compatible = "zmk,behavior-macro";
                wait-ms = <40>;
                tap-ms = <40>;
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp F6>
                    , <&macro_release &kp LCTRL>
                    ;
            };
            file_r: file_r { // ファイルの切り替え逆
                compatible = "zmk,behavior-macro";
                wait-ms = <40>;
                tap-ms = <40>;
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LSHFT>
                    , <&macro_press &kp LCTRL>
                    , <&macro_tap &kp F6>
                    , <&macro_release &kp LCTRL>
                    , <&macro_release &kp LSHFT>
                    ;
            };
            pr_pg: pr_pg { // 前ページ切り替え
                compatible = "zmk,behavior-macro";
                wait-ms = <40>;
                tap-ms = <40>;
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LSHFT>
                    , <&macro_tap &kp F5>
                    , <&macro_release &kp LSHFT>
                    ;
            };
            nx_pg: nx_pg { // 次ページ切り替え
                compatible = "zmk,behavior-macro";
                wait-ms = <40>;
                tap-ms = <40>;
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LSHFT>
                    , <&macro_tap &kp F6>
                    , <&macro_release &kp LSHFT>
                    ;
            };
            alt_right: alt_right { // フォルダ移動進む
                compatible = "zmk,behavior-macro";
                wait-ms = <40>;
                tap-ms = <40>;
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LALT>
                    , <&macro_tap &kp RIGHT>
                    , <&macro_release &kp LALT>
                    ;
            };
            alt_left: alt_left { // フォルダ移動戻る
                compatible = "zmk,behavior-macro";
                wait-ms = <40>;
                tap-ms = <40>;
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LALT>
                    , <&macro_tap &kp LEFT>
                    , <&macro_release &kp LALT>
                    ;
            };
            alt_up: alt_up { // フォルダ移動上
                compatible = "zmk,behavior-macro";
                wait-ms = <40>;
                tap-ms = <40>;
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LALT>
                    , <&macro_tap &kp UP>
                    , <&macro_release &kp LALT>
                    ;
            };
            alt_down: alt_down { // フォルダ移動下
                compatible = "zmk,behavior-macro";
                wait-ms = <40>;
                tap-ms = <40>;
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LALT>
                    , <&macro_tap &kp DOWN>
                    , <&macro_release &kp LALT>
                    ;
            };
            cmd_x: cmd_x { // 切り取り
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LGUI>
                    , <&macro_tap &kp X>
                    , <&macro_release &kp LGUI>
                    ;
            };
            cmd_c: cmd_c { // コピー
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LGUI>
                    , <&macro_tap &kp C>
                    , <&macro_release &kp LGUI>
                    ;
            };
            cmd_v: cmd_v { // 貼り付け
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LGUI>
                    , <&macro_tap &kp V>
                    , <&macro_release &kp LGUI>
                    ;
            };
            ctrl_x: ctrl_x { // 切り取り
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp X>
                    , <&macro_release &kp LCTRL>
                    ;
            };
            ctrl_c: ctrl_c { // コピー
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp C>
                    , <&macro_release &kp LCTRL>
                    ;
            };
            ctrl_v: ctrl_v { // 貼り付け
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp V>
                    , <&macro_release &kp LCTRL>
                    ;
            };
            shft_mb1: shft_mb1 { // Shiftキー+左クリック
                compatible = "zmk,behavior-macro";
                wait-ms = <40>;
                tap-ms = <40>;
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LSHFT>
                    , <&macro_tap &mkp MB1>
                    , <&macro_release &kp LSHFT>
                    ;
            };
            alt_enter: alt_enter { // alt+enter
                compatible = "zmk,behavior-macro";
                wait-ms = <40>;
                tap-ms = <40>;
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LALT>
                    , <&macro_tap &kp ENTER>
                    , <&macro_release &kp LALT>
                    ;
            };
            gui_enter: gui_enter { // gui+enter
                compatible = "zmk,behavior-macro";
                wait-ms = <40>;
                tap-ms = <40>;
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp RGUI>
                    , <&macro_tap &kp ENTER>
                    , <&macro_release &kp RGUI>
                    ;
            };
            ctrl_shift: ctrl_shift { // ctrl+shiftマクロ
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&kp LCTRL &kp LSHFT>; // Ctrl+Shiftを押しっぱなしにするマクロ
                // bindings
                //     = <&macro_press &kp LCTRL>
                //     , <&macro_press &kp LSHFT>
                //     , <&macro_release &kp LSHFT>
                //     , <&macro_release &kp LCTRL>
                //     ;
            };	

            grave_uc: grave_uc {
                compatible = "zmk,behavior-macro";
                wait-ms = <40>;
                tap-ms = <40>;
                #binding-cells = <0>;
                bindings
                    = <&macro_press   &kp LALT>
                    , <&macro_tap     &kp KP_N9 &kp KP_N6>
                    , <&macro_release &kp LALT>
                    ;
            };
            tilde_uc: tilde_uc {
                compatible = "zmk,behavior-macro";
                wait-ms = <40>;
                tap-ms = <40>;
                #binding-cells = <0>;
                bindings
                    = <&macro_press   &kp LALT>
                    , <&macro_tap     &kp KP_N1 &kp KP_N2 &kp KP_N6>
                    , <&macro_release &kp LALT>
                    ;
            };

            to_QWE_i5: to_QWE_INT5 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to QWE>, <&kp INT5>;
            };
            to_WIN_i2: to_WIN_INT2 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to WIN>, <&kp INT2>;
            };
            to_WIN_i4: to_WIN_INT4 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to WIN>, <&kp INT4>;
            };
            to_WIN_i5: to_WIN_i5 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to WIN>, <&kp INT5>;
            };
            to_WIN_l1: to_WIN_l1 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to WIN>, <&kp LANG1>;
            };
            to_MOV_i2: to_MOV_INT2 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to MOV>, <&kp INT2>;
            };
            to_MOVL_i5: to_MOVL_INT5{
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to MOVL>, <&kp INT5>;
            };
            to_MOVW_i5: to_MOVW_INT5{
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to MOVW>, <&kp INT5>;
            };
            to_CAD_i2: to_CAD_INT2 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to CAD>, <&kp INT2>;
            };
            to_CAD_i5: to_CAD_i5 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to CAD>, <&kp INT5>;
            };
            to_CAD_l2: to_CAD_l2 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to CAD>, <&kp LANG2>;
            };
            to_NUM_i5: to_NUM_i5 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to NUM>, <&kp INT5>;
            };
            to_NUML_i5: to_NUML_i5 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to NUML>, <&kp INT5>;
            };
            to_NUMW_i5: to_NUMW_i5 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to NUMW>, <&kp INT5>;
            };

            int5_g: int5_g { // 端点再設定(AHK)
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp INT5>
                    , <&macro_wait_time 40>
                    , <&macro_tap &kp G>
                    , <&macro_wait_time 40>
                    , <&macro_release &kp INT5>
                    ;
            };	
            exl_fill: excel_fill_menu { // Excelのフィルター
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <30>;
                tap-ms = <30>;
                bindings
                    = <&macro_tap &kp LALT>
                    , <&macro_tap &kp E &kp I &kp S>;
                // ここで止まるので、設定を確認して手動でEnter
            };
            exl_group_close: excel_group_close { // Excelのグループ化/閉じる
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <30>;
                tap-ms = <30>;   // キーを押し下げている時間
                bindings = 
                    <&macro_tap &kp LALT>,      // Altをタップ
                    <&kp A>,
                    <&kp H>;                    // H（グループ化/閉じる）
            };
            exl_group_open: excel_group_open { // Excelのグループ化/開く
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <30>;
                tap-ms = <30>;   // キーを押し下げている時間
                bindings = 
                    <&macro_tap &kp LALT>,      // Altをタップ
                    <&kp A>,
                    <&kp J>;                    // J（グループ化/開く）
            };
            // 1. セル内文字列をコピーしてEnter
            cp_enter: cp_enter {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <30>;
                tap-ms = <30>;
                bindings = 
                    <&kp F2>,               // 編集モードに入る
                    <&kp LC(A)>,            // 全選択 (Ctrl + A)
                    <&kp LC(C)>,            // コピー (Ctrl + C)
                    <&kp ENTER>;            // 確定＆下のセルへ移動
            };
            // 2. セル内文字列をコピーしてTAB
            cp_tab: cp_tab {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <30>;
                tap-ms = <30>;
                bindings = 
                    <&kp F2>,               // 編集モードに入る
                    <&kp LC(A)>,            // 全選択 (Ctrl + A)
                    <&kp LC(C)>,            // コピー (Ctrl + C)
                    <&kp TAB>;              // 確定＆右のセルへ移動
            };
            excel_move_row_cut: excel_move_row_cut { // Excelの行選択切取り
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <40>;
                tap-ms = <40>;
                bindings
                    = <&macro_press   &kp LSFT>
                    , <&macro_tap     &kp SPACE>
                    , <&macro_release &kp LSFT>
                    , <&macro_wait_time 100> // ここで100ミリ秒待機
                    , <&macro_press   &kp LCTRL>
                    , <&macro_tap     &kp X>
                    , <&macro_release &kp LCTRL>
                    ;
            };
            excel_move_row_copy: excel_move_row_copy { // Excelの行選択コピー
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <40>;
                tap-ms = <40>;
                bindings
                    = <&macro_press   &kp LSFT>
                    , <&macro_tap     &kp SPACE>
                    , <&macro_release &kp LSFT>
                    , <&macro_wait_time 100> // ここで100ミリ秒待機
                    , <&macro_press   &kp LCTRL>
                    , <&macro_tap     &kp C>
                    , <&macro_release &kp LCTRL>
                    ;
            };
            excel_move_row_paste: excel_move_row_paste { // Excelの行移動(下に挿入)
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <40>;
                tap-ms = <40>;
                bindings
                    = <&macro_press   &kp LSFT>
                    , <&macro_tap     &kp SPACE>
                    , <&macro_release &kp LSFT>
                    , <&macro_wait_time 100> // ここで100ミリ秒待機
                    , <&macro_press   &kp LCTRL>
                    // , <&macro_press   &kp LSFT>
                    , <&macro_tap     &kp KP_PLUS>
                    // , <&macro_release &kp LSFT>
                    , <&macro_release &kp LCTRL>
                    ;
            };
            excel_line_erase: excel_line_erase { // Excelの罫線消去
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <40>;
                tap-ms = <40>;
                bindings
                    = <&macro_press   &kp LSFT>
                    , <&macro_press   &kp LCTRL>
                    , <&macro_wait_time 80> // ここで80ミリ秒待機
                    , <&macro_tap     &kp INT1>
                    , <&macro_wait_time 80> // ここで80ミリ秒待機
                    , <&macro_release &kp LSFT>
                    , <&macro_release &kp LCTRL>
                    ;
            };
            excel_line_erase_p: excel_line_erase_p { // Excelの罫線消去(Pause Break)
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <40>;
                tap-ms = <40>;
                bindings
                    = <&macro_tap     &kp PAUSE_BREAK>
                    , <&macro_wait_time 100> // ここで100ミリ秒待機
                    , <&macro_press   &kp LSFT>
                    , <&macro_press   &kp LCTRL>
                    , <&macro_wait_time 80> // ここで80ミリ秒待機
                    , <&macro_tap     &kp INT1>
                    , <&macro_wait_time 80> // ここで80ミリ秒待機
                    , <&macro_release &kp LSFT>
                    , <&macro_release &kp LCTRL>
                    , <&macro_wait_time 100> // ここで100ミリ秒待機
                    , <&macro_tap     &kp PAUSE_BREAK>
                    ;
            };
            excel_ruled_line_free_write: excel_ruled_line_free_write { // Excelの罫線ペン
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <40>;
                tap-ms = <40>;
                bindings
                    = <&macro_tap   &kp LALT>
                    , <&macro_tap   &kp H>
                    , <&macro_tap   &kp B>
                    , <&macro_tap   &kp W>
                    ;
            };
            excel_ruled_line_free_erase: excel_ruled_line_free_erase { // Excelの罫線消しゴム
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <40>;
                tap-ms = <40>;
                bindings
                    = <&macro_tap   &kp LALT>
                    , <&macro_tap   &kp H>
                    , <&macro_tap   &kp B>
                    , <&macro_tap   &kp E>
                    ;
            };
            excel_ruled_line_all_drawing: excel_ruled_line_all_drawing { // Excelの罫線格子状
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <40>;
                tap-ms = <40>;
                bindings
                    = <&macro_tap   &kp LALT>
                    , <&macro_tap   &kp H>
                    , <&macro_tap   &kp B>
                    , <&macro_tap   &kp A>
                    ;
            };
            excel_ruled_line_fat_drawing: excel_ruled_line_fat_drawing { // Excelの罫線太い外枠
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <40>;
                tap-ms = <40>;
                bindings
                    = <&macro_tap   &kp LALT>
                    , <&macro_tap   &kp H>
                    , <&macro_tap   &kp B>
                    , <&macro_tap   &kp T>
                    ;
            };
            excel_clear_cf: excel_clear_cf { // Excelの条件付き書式のクリア(選択範囲)
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <40>;
                tap-ms = <40>;
                bindings
                    = <&macro_tap     &kp LALT>
                    , <&macro_tap     &kp H>
                    , <&macro_tap     &kp L>
                    , <&macro_tap     &kp C>
                    , <&macro_tap     &kp S>
                    ;
            };
            mb3_mb1: mb3_mb1 { //FreeCADのマウスボタン3+1 (トグル動作例)
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &mkp MB3>
                    , <&macro_press &mkp MB1>
                    , <&macro_pause_for_release>
                    , <&macro_release &mkp MB3>
                    , <&macro_release &mkp MB1>;
            };
            // // HiMacro変換版：コピー ➔ TAB移動 ➔ 画面切り替え ➔ 貼り付け ➔ 元の画面に戻る
