            // };
            combo_RGUI {
                bindings = <&kp RGUI>;
                key-positions = <28 29>;
                layers = <QWE LWR RSE ADJ MOV>;
                timeout-ms = <80>;
            };
            combo_LGUI {
                bindings = <&kp LGUI>;
                key-positions = <20 21>;
                layers = <LIN CAD LWRL LWRW RSEL RSEW MOVL MOVW>;
                timeout-ms = <80>;
            };
            combo_LALT {
                bindings = <&kp LALT>;
                key-positions = <20 21>;
                layers = <QWE LWR RSE ADJ>;
                timeout-ms = <80>;
            };
            combo_RALT {
