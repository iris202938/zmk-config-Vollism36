        ctrl_f_r: ctrl_f_r { // R枠変更
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp F>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp R>
                ;
        };
        ctrl_d_l: ctrl_d_l { // 並行補助線入力
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp D>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp L>
                ;
        };
        ctrl_d_d: ctrl_d_d { // 補助線削除
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp D>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp D>
                ;
        };
        ctrl_a_c: ctrl_a_c { // コピー
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp A>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp C>
                ;
        };
        ctrl_a_v: ctrl_a_v { // 貼付け
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp A>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp V>
                ;
        };
        ctrl_d_q: ctrl_d_q { // 円(中心)
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp D>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp Q>
                ;
        };
        ctrl_a_k: ctrl_a_k { // コメント
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp A>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp K>
                ;
        };
        ctrl_d_c: ctrl_d_c { // 製品情報
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp D>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp C>
                ;
        };
        alt_home: alt_home { // 移動左90度回転[AHK]
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp HOME>
                , <&macro_release &kp LALT>
                ;
        };
        alt_end: alt_end { // 移動右90度回転[AHK]
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp END>
                , <&macro_release &kp LALT>
                ;
        };
        ctrl_d_g: ctrl_d_g { // グループ化解除
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp D>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp G>
                // , <&to WIN> // ADJWのベースレイヤー（例としてWINレイヤー）に戻る※rsewレイヤロック強制解除用
                ;
        }; 
        ctrl_a_b: ctrl_a_b { // 長方形(サイズ)
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp A>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp B>
                ;
        };
        ctrl_d_i: ctrl_d_i { // 連続寸法線
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp D>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp I>
                ;
        }; 
        ctrl_d_b: ctrl_d_b { // 面取り
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp D>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp B>
                ;
        }; 
        ctrl_d_t: ctrl_d_t { // シンボルレイヤ変更
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp D>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp T>
                ;
        }; 

        // m_alt_tab: m_alt_tab {
        // 	label = "ALT_TAB_HOLD";
        // 	compatible = "zmk,behavior-macro";
        //     #binding-cells = <0>;
        //     bindings
        //         = <&macro_press &kp LALT>
        //         , <&macro_tap &kp TAB>
