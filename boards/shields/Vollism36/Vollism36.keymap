        // };
        // dot_qmark: dot_question {
        //     compatible = "zmk,behavior-mod-morph";
        //     #binding-cells = <0>;
        //     bindings = <&kp DOT>, <&kp QMARK>;
        //     mods = <(MOD_LSFT)>;
        // };            
        // tog_on: toggle_layer_on_only {
        //     compatible = "zmk,behavior-toggle-layer";
        //     #binding-cells = <1>;
        //     display-name = "Toggle Layer On";
        //     toggle-mode = "on";
        // };
        // tog_off: toggle_layer_off_only {
        //     compatible = "zmk,behavior-toggle-layer";
        //     #binding-cells = <1>;
        //     display-name = "Toggle Layer Off";
        //     toggle-mode = "off";
        // };
        
        bt0_l0: bt0_l0 { // Bluetoothプロファイル0を選択し、レイヤー0を有効化
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to WIN &bt BT_SEL 0 &to WIN>;
        };

        bt1_l4: bt1_l4 { // Bluetoothプロファイル1を選択し、レイヤー4を有効化
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to WIN &bt BT_SEL 1 &to WIN>;
        };

        bt2_l4: bt2_l4 { // Bluetoothプロファイル2を選択し、レイヤー4を有効化
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to WIN &bt BT_SEL 2 &to WIN>;
        };

        bt3_l4: bt3_l4 { // Bluetoothプロファイル3を選択し、レイヤー4を有効化
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to WIN &bt BT_SEL 3 &to WIN>;
        };

        bt4_l2: bt4_l2 { // Bluetoothプロファイル4を選択し、レイヤー2を有効化
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to WIN &bt BT_SEL 4 &to WIN>;
        };

        bt4_l3: bt4_l3 { // Bluetoothプロファイル4を選択し、レイヤー3を有効化
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to WIN &bt BT_SEL 4 &to WIN>;
        };

        usb_l0: usb_l0 { // USB接続を選択し、レイヤー0を有効化
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to WIN &out OUT_USB &to WIN>;
        };
        usb_l2: usb_l2 { // USB接続を選択し、レイヤー2を有効化
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to WIN &out OUT_USB &to WIN>;
        };
        // td_lt_mov_l1: tap_dance_layer_tap_mov_l1 {  // タップでLANG1、ホールドでMOVレイヤ、ダブルタップでMOVレイヤ保持
        //     compatible = "zmk,behavior-tap-dance";
        //     #binding-cells = <0>;
        //     tapping-term-ms = <200>;
        //     bindings = <&lt MOV LANG1>, <&to MOV>;
        // };
		// td_lt_num_l2: tap_dance_layer_tap_num_l2 {  // タップでLANG2、ホールドでNUMレイヤ、ダブルタップでNUMレイヤ保持
        //     compatible = "zmk,behavior-tap-dance";
        //     #binding-cells = <0>;
        //     tapping-term-ms = <200>;
        //     bindings = <&lt NUM LANG2>, <&to NUM>;
        // };
		td_lt_mov_i2: tap_dance_layer_tap_mov_i2 {  // タップでINT2、ホールドでMOVレイヤ、ダブルタップでMOVレイヤ保持
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&lt MOV INT2>, <&to_MOV_i5>;
        };
		td_lt_num_i5: tap_dance_layer_tap_num_i5 {  // タップでINT5、ホールドでNUMレイヤ、ダブルタップでNUMレイヤ保持
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&lt NUM INT5>, <&to_NUM_i5>;
        };
    };

