                timeout-ms = <80>;
                key-positions = <15 18 22>; // H,L,Cのキー位置に書き換えてください
                layers = <MOVL MOVW>;
                bindings = <&excel_clear_cf>;
            };

            combo_lefthand_enter { // 左手のみでEnterを押す
                timeout-ms = <80>;
                key-positions = <21 22 23>;
                layers = <LWR LWRW LWRL NUM NUMW NUML>;
                bindings = <&kp ENTER>;
            };
