    #include <behaviors.dtsi>
    // #include <behaviors/naginata.dtsi>
    #include <dt-bindings/zmk/bt.h>
    #include <dt-bindings/zmk/keys.h>
    #include <dt-bindings/zmk/mouse.h>
    #include <dt-bindings/zmk/outputs.h>
    #include <dt-bindings/zmk/pointing.h>
    #include <behaviors/rgbled_widget.dtsi>  // led制御

    #define ZMK_POINTING_DEFAULT_MOVE_VAL 600
    #define ZMK_POINTING_DEFAULT_SCRL_VAL 10

    #define QWE 0
    #define NIC 1
    #define LIN 2
    #define NICL 3
    #define CAD 4
    #define WIN 5
    #define LWR 6
    #define LWRL 7
    #define LWRW 8
    #define RSE 9
    #define RSEL 10
    #define RSEW 11
    #define ADJ 12
    #define ADJL 13
    #define ADJW 14
    #define MOV 15
    #define MOVL 16
    #define MOVW 17
    #define NUM 18
    #define NUML 19
    #define NUMW 20
    #define WINS 21
    #define BLE 22

    &mt {
        flavor = "hold-preferred";
        tapping-term-ms = <160>;
        quick-tap-ms = <0>;
    };

    &lt {
        flavor = "hold-preferred";
    };

    &sk {
        release-after-ms = <3000>; // 3秒間入力を待つ
        quick-release;
    };

    &sl {
        release-after-ms = <3000>; // 3秒間入力を待つ
    };

    &caps_word {
        continue-list = <UNDERSCORE MINUS SPACE CARET PERIOD COMMA ENTER TAB BACKSPACE SLASH KP_N0 KP_N1 KP_N2 KP_N3 KP_N4 KP_N5 KP_N6 KP_N7 KP_N8 KP_N9 KP_MINUS KP_DOT KP_ENTER KP_SLASH KP_ASTERISK KP_PLUS KP_EQUAL>; 
        };

    / {

