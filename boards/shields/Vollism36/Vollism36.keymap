        file_f: file_f { // ファイルの切り替え正
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp F6> // マクロキー押下時にLCTRLとF6を同時に押す
                , <&macro_release &kp LCTRL &kp F6> // マクロキー解放時にLCTRLとF6を同時に離す
                // = <&macro_press &kp LCTRL>
                // , <&macro_tap &kp F6>
                // , <&macro_release &kp LCTRL>
                ;
        };

        file_r: file_r { // ファイルの切り替え逆
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT &kp LCTRL &kp F6> // マクロキー押下時にLSHFTとLCTRLとF6を同時に押す
                , <&macro_release &kp LSHFT &kp LCTRL &kp F6> // マクロキー解放時にLSHFTとLCTRLとF6を同時に離す
                // = <&macro_press &kp LSHFT>
                // , <&macro_press &kp LCTRL>
                // , <&macro_tap &kp F6>
                // , <&macro_release &kp LCTRL>
                // , <&macro_release &kp LSHFT>
                ;
        };

        pr_pg: pr_pg { // 前ページ切り替え
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT &kp F5> // マクロキー押下時にLSHFTとF5を同時に押す
                , <&macro_release &kp LSHFT &kp F5> // マクロキー解放時にLSHFTとF5を同時に離す
                // = <&macro_press &kp LSHFT>
                // , <&macro_tap &kp F5>
                // , <&macro_release &kp LSHFT>
                ;
        };

        nx_pg: nx_pg { // 次ページ切り替え
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT &kp F6> // マクロキー押下時にLSHFTとF6を同時に押す
                , <&macro_release &kp LSHFT &kp F6> // マクロキー解放時にLSHFTとF6を同時に離す
                // = <&macro_press &kp LSHFT>
                // , <&macro_tap &kp F6>
                // , <&macro_release &kp LSHFT>
                ;
        };

        alt_right: alt_right { // フォルダ移動進む
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT &kp RIGHT>
                , <&macro_release &kp LALT &kp RIGHT>
                // = <&macro_press &kp LALT>
                // , <&macro_tap &kp RIGHT>
                // , <&macro_release &kp LALT>
                ;
        };

        alt_left: alt_left { // フォルダ移動戻る
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT &kp LEFT>
                , <&macro_release &kp LALT &kp LEFT>
                // = <&macro_press &kp LALT>
                // , <&macro_tap &kp LEFT>
                // , <&macro_release &kp LALT>
                ;
        };

        alt_up: alt_up { // フォルダ移動上
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT &kp  UP>
                , <&macro_release &kp LALT &kp UP>
                // = <&macro_press &kp LALT>
                // , <&macro_tap &kp UP>
                // , <&macro_release &kp LALT>
                ;
        };

        alt_down: alt_down { // フォルダ移動下
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT &kp DOWN>
                , <&macro_release &kp LALT &kp DOWN>
                // = <&macro_press &kp LALT>
                // , <&macro_tap &kp DOWN>
                // , <&macro_release &kp LALT>
                ;
        };

        grave_uc: grave_uc {
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press   &kp LALT>
                , <&macro_tap     &kp KP_N9 &kp KP_N6>
                , <&macro_release &kp LALT>
                ;
        };

        tilde_uc: tilde_uc {
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press   &kp LALT>
                , <&macro_tap     &kp KP_N1 &kp KP_N2 &kp KP_N6>
                , <&macro_release &kp LALT>
                ;
        };

        // to_QWE_l2: to_QWE_LANG2{
        // 	compatible = "zmk,behavior-macro";
        // 	#binding-cells = <0>;
        // 	bindings = <&to QWE>, <&kp LANG2>;
        // };

        to_WIN_i5: to_WIN_INT5{
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to WIN>, <&kp INT5>;
        };

        to_MOV_i5: to_MOV_INT5{
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to MOV>, <&kp INT5>;
        };

        to_NUM_i5: to_NUM_INT5{
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to NUM>, <&kp INT5>;
        };

        int5_g: int5_g { // 端点再設定(AHK)
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp INT5>
                , <&macro_wait_time 40>
                , <&macro_tap &kp G>
                , <&macro_wait_time 40>
                , <&macro_release &kp INT5>
                ;
        };	

        alt_int4: alt_int4 { // Alt+変換 選択位置移動(複写)(AHK)
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press   &kp RALT>
                , <&macro_tap     &kp INT4>
                , <&macro_release &kp RALT>
                ;
        };	

        alt_int5: alt_int5 { // Alt+無変換 選択位置移動(移動)(AHK)
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press   &kp RALT>
                , <&macro_tap     &kp INT5>
                , <&macro_release &kp RALT>
                ;
        };

        alt_slash: alt_slash { // ファイル切替　Alt+/ (AHK)
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press   &kp RALT>
                , <&macro_tap     &kp SLASH>
                , <&macro_release &kp RALT>
                ;
        };

        win_right: win_right { // デスクトップ移動進む
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_press &kp LCTRL>
                // , <&macro_wait_time 40>
                , <&macro_tap &kp RIGHT>
                // , <&macro_wait_time 40>
                , <&macro_release &kp LCTRL>
                , <&macro_release &kp LGUI>
                ;
        };

        win_left: win_left { // デスクトップ移動戻る
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_press &kp LCTRL>
                // , <&macro_wait_time 40>
                , <&macro_tap &kp LEFT>
                // , <&macro_wait_time 40>
                , <&macro_release &kp LCTRL>
                , <&macro_release &kp LGUI>
                ;
        };

        // m_alt_tab: m_alt_tab {
        // 	label = "ALT_TAB_HOLD";
        // 	compatible = "zmk,behavior-macro";
        //     #binding-cells = <0>;
        //     bindings
        //         = <&macro_press &kp LALT>
        //         , <&macro_tap &kp TAB>
        //         , <&macro_wait_time 1000>
        //         , <&macro_release &kp LALT>
        //         ;
        // };

        // m_alt_s_tab: m_alt_s_tab {
        //     label = "ALT_SHFT_TAB_HOLD";
        //     compatible = "zmk,behavior-macro";
        //     #binding-cells = <0>;
        //     bindings
        //         = <&macro_press &kp LALT>
        //         , <&macro_press &kp LSHFT>
        //         , <&macro_tap &kp TAB>
        //         , <&macro_wait_time 50>
        //         , <&macro_release &kp LSHFT>
        //         , <&macro_wait_time 1000>
        //         , <&macro_release &kp LALT>
        //         ;
        // };
    };

    keymap {
        compatible = "zmk,keymap";

        WIN {
            bindings = <
            &kp Q           &kp W    &kp E          &kp R               &kp T                                                     &kp Y           &kp U              &kp I          &kp O      &kp P
            &kp A           &kp S    &kp D          &kp F                                                       &kp G             &kp H           &kp J              &kp K          &kp L      &kp SEMICOLON
            &kp Z           &kp X    &kp C          &kp V                                                       &kp B             &kp N           &kp M              &kp COMMA      &kp DOT    &kp SLASH
                                                    &td_lt_num_i5       &kp SPACE             &mo LWR           &lt RSE ENTER     &kp INT4        &td_lt_mov_i2
            >;
        };

        LWR {
            bindings = <
            &kp PG_UP  &kp HOME    &kp UP        &kp END       &mkp MB3                             &kp DEL        &msc SCRL_LEFT &mmv MOVE_UP   &msc SCRL_RIGHT   &msc SCRL_UP
            &kp PG_DN  &kp LEFT    &kp DOWN      &kp RIGHT   	                        &mkp MB1    &kp BSPC       &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT   &msc SCRL_DOWN
            &kp LC(V)  &mkp MB1    &mkp MB3      &mkp MB2		                        &mkp MB2    &mkp MB1       &kp ENTER      &kp LC(LEFT)   &kp LC(RIGHT)     &kp LG(V)
                                                 &kp LSHFT     &trans   	&trans      &trans      &kp LS(LC(V))  &kp RSHFT
            >;
        };

        RSE {
            bindings = <
            &kp F1            &kp F2      &kp F3      &kp F4      &kp F5         		    		   &kp F6         &kp F7    	&kp F8      	&kp F9      &kp F10
            &kp N1            &kp N2      &kp N3      &kp N4      		     		    &kp N5         &kp N6         &kp N7    	&kp N8      	&kp N9      &kp N0
            &kp INT1          &kp BSLH    &kp INT3    &kp SLASH   		     		    &kp ASTRK      &kp MINUS      &kp PLUS  	&kp LBKT    	&kp RBKT    &kp LC(V)
                                                      &kp LSHFT   &kp SPACE &trans      &trans         &trans   	  &kp RSHFT
            >;
        };

        ADJ {
            bindings = <
            &kp F11        &kp F12        &kp C_MUTE        &kp C_VOL_DN   &kp C_VOL_UP                                    &kp CAPS       &kp PSCRN      &kp SLCK         &kp PAUSE_BREAK   &kp LS(UP)
            &out OUT_BLE   &usb_l2        &bt3_l4           &kp LS(RIGHT)                                   &kp G          &kp INT5       &file_r        &pr_pg           &nx_pg            &file_f
            &bt0_l0        &bt1_l4        &bt2_l4           &kp K_APP                                       &kp LS(LEFT)   &kp LS(DOWN)   &kp LS(HOME)   &kp LS(LC(LEFT)) &kp LS(LC(RIGHT)) &kp LS(END)
                                                            &trans         &grave_uc        &trans          &trans         &tilde_uc	  &trans
            >;

        };

        MOV {
            bindings = <
            &kp LS(LC(TAB))       &msc SCRL_LEFT  &msc SCRL_UP      &msc SCRL_RIGHT   &kp LCTRL                                         &kp LC(Y)      &kp HOME         &kp UP        &kp END        &kp PG_UP
            &mkp MB1              &mkp MB1        &msc SCRL_DOWN    &mkp MB2                                           &msc SCRL_DOWN   &lt BLE BSPC   &kp LEFT         &kp DOWN      &kp RIGHT      &kp PG_DN
            &mt LGUI SPACE        &kp LA(LEFT)    &mkp MB3          &kp LA(RIGHT)                                      &kp LC(TAB)      &kp LC(Z)      &kp LC(PG_UP)    &kp LG(LBKT)  &kp LG(RBKT)   &kp LC(PG_DN)
                                                                    &kp LC(C)         &kp LSHFT        &mkp MB2        &kp ENTER        &mkp MB1       &to_WIN_i5
            >;
        };

        NUM {
            bindings = <
            &kp PG_UP     &kp HOME        &kp UP        &kp END         &kp CARET                                           &kp KP_SLASH    &kp KP_N7   &kp KP_N8   &kp KP_N9     &kp KP_N0
            &kp PG_DN     &kp LEFT        &kp DOWN      &kp RIGHT                                         &lt BLE DEL       &kp BSPC        &kp KP_N4   &kp KP_N5   &kp KP_N6     &kp KP_MINUS
            &alt_left	  &alt_down       &alt_up       &alt_right                                        &kp EQUAL         &kp KP_MULTIPLY &kp KP_N1   &kp KP_N2   &kp KP_N3     &kp KP_PLUS
                                                        &to_WIN_i5      &pr_pg	    	  &nx_pg          &kp KP_ENTER      &kp UNDER       &kp SPACE
            >;
        };
        BLE {
            bindings = <
            &bt BT_DISC 0     &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3   &bt BT_CLR_ALL                                 &bt BT_CLR_ALL &bt BT_DISC 4   &bt BT_DISC 5 &bt BT_DISC 6 &bt BT_DISC 7
            &kp LC(LG(T))     &kp LC(LG(C))  &kp LC(LG(P))  &kp LC(LG(G))                                  &trans          &trans         &kp LC(LG(E))   &kp LC(LG(A)) &kp LC(LG(L)) &kp LC(LG(X))
            &bt BT_SEL 0      &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3                                   &bootloader     &bootloader    &bt4_l2     	  &bt BT_SEL 5  &bt BT_SEL 6  &bt BT_SEL 7
                                                            &trans          &kp LS(LG(F23)) &bt BT_CLR     &bt BT_CLR      &kp LA(LG(G))  &trans
            >;
        };
    };
};
