            //     key-positions = <10 11>;
            //     layers = <ADJ ADJL ADJW>;
            //     timeout-ms = <80>;
            // };
            ins {
                bindings = <&kp INS>;
                key-positions = <8 9>;
                layers = <ADJ ADJL ADJW>;
                timeout-ms = <80>;
            };
            file_f {
                bindings = <&file_f>;
                key-positions = <1 2>;
                layers = <CAD>;
                timeout-ms = <80>;
