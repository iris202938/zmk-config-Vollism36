        // Ctrl + A, S: シンボル置換
        ctrl_a_s: ctrl_a_s {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                , <&macro_tap &kp S>
                ;
        };

        // Ctrl + A, T: 文章
        ctrl_a_t: ctrl_a_t {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                , <&macro_tap &kp T>
                ;
        };

        // Ctrl + A, U: 連続寸法線削除
        ctrl_a_u: ctrl_a_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                , <&macro_tap &kp U>
                ;
        };

        // Ctrl + A, V: 貼り付け
        ctrl_a_v: ctrl_a_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                , <&macro_tap &kp V>
                ;
        };

        // Ctrl + A, W: 渡りページ編集
