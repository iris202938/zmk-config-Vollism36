            //         <&kp LC(A)>,                            // Ctrl + A（全選択）
            //         <&kp LC(C)>,                            // Ctrl + C（コピー）
            //         <&kp TAB>,                              // ★ EnterからTABに変更（右のセルへ移動＆確定）
            //         <&macro_press &kp LALT>,
            //         <&macro_wait_time 20>,                  // ここで20ミリ秒待機
            //         <&kp TAB>,                              // Altを押しながらTab
            //         <&macro_wait_time 20>,                  // ここで20ミリ秒待機
            //         <&macro_release &kp LALT>,              // Altを離す（ウィンドウ切り替え）
            //         <&macro_wait_time 20>,                  // ここで20ミリ秒待機
            //         <&kp LC(V)>,                            // Ctrl + V（貼り付け）
            //         <&kp ENTER>,                            // Enter
            //         <&kp ESC>,                              // Esc
            //         <&macro_press &kp LALT>,
            //         <&macro_wait_time 20>,                  // ここで20ミリ秒待機
            //         <&kp TAB>,                              // Altを押しながらTab
            //         <&macro_wait_time 20>,                  // ここで20ミリ秒待機
            //         <&macro_release &kp LALT>;              // Altを離す（元の画面に戻る）
            // };
            alt_int4: alt_int4 { // Alt+変換 選択位置移動(複写)(AHK)
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press   &kp LALT>
                    , <&macro_tap     &kp INT4>
                    , <&macro_release &kp LALT>
                    ;
            };	
            alt_int5: alt_int5 { // Alt+無変換 選択位置移動(移動)(AHK)
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press   &kp LALT>
                    , <&macro_tap     &kp INT5>
                    , <&macro_release &kp LALT>
                    ;
            };
            LGUI_LCTRL: LGUI_LCTRL {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&kp LGUI>, <&kp LCTRL>;
            };
            win_right: win_right { // デスクトップ移動進む
                compatible = "zmk,behavior-macro";
                wait-ms = <40>;
                tap-ms = <40>;
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LGUI>
                    , <&macro_press &kp LCTRL>
                    , <&macro_tap &kp RIGHT>
                    , <&macro_release &kp LCTRL>
                    , <&macro_release &kp LGUI>
                    ;
            };
            win_left: win_left { // デスクトップ移動戻る
                compatible = "zmk,behavior-macro";
                wait-ms = <40>;
                tap-ms = <40>;
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LGUI>
                    , <&macro_press &kp LCTRL>
                    , <&macro_tap &kp LEFT>
                    , <&macro_release &kp LCTRL>
                    , <&macro_release &kp LGUI>
                    ;
            };
            // macro_INT2: macro_INT2 {
            //     compatible = "zmk,behavior-macro";
            //     label = "macro_INT2";
            //     #binding-cells = <0>;
            //     bindings = <&kp INT2>, <&to WIN>;
            // };
            // macro_INT5: macro_INT5 {
            //     compatible = "zmk,behavior-macro";
            //     label = "macro_INT5";
            //     #binding-cells = <0>;
            //     bindings = <&kp INT5>, <&to QWE>;
            // };
            // macro_LANG1: macro_LANG1 {
            //     compatible = "zmk,behavior-macro";
            //     label = "macro_LANG1";
            //     #binding-cells = <0>;
            //     bindings = <&kp LANG1>, <&to WIN>;
            // };
            // macro_LANG2: macro_LANG2 {
            //     compatible = "zmk,behavior-macro";
            //     label = "macro_LANG2";
            //     #binding-cells = <0>;
            //     bindings = <&kp LANG2>, <&to QWE>;
            // };
            // タップ時の動作: 指定レイヤーへ移動し、LANG1を送信
            // LANG1用のマクロ
            t_lang1: t_lang1 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to NIC &kp LANG1>; // レイヤー2（NIC）に戻る
            };
            t_lang2: t_lang2 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to QWE &kp LANG2>; // レイヤー0（QWE）に戻る
            };
            t_eint2: t_eint2 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&kp ESC &kp INT2>;
            };
            t_int4: t_int4 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to NICL &kp INT4>; // レイヤー5（NICL）に戻る
            };
            t_int5: t_int5 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <10>; // 全体の基本遅延
                tap-ms = <10>;
                bindings 
                    = <&to LIN> // レイヤー3（LIN）に戻る
                    , <&macro_wait_time 20> // ここで20ミリ秒待機
                    , <&kp  INT5>
                    , <&kp  LANG2>;
            };
            tW_int4: tW_int4 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to WIN &kp INT4 &kp LANG1>; // レイヤー7（WIN）に戻る
            };
            tC_int5: tC_int5 {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <10>; // 全体の基本遅延
                tap-ms = <10>;
                bindings 
                    = <&to CAD> // レイヤー6（CAD）に戻る
                    , <&macro_wait_time 30> // ここで30ミリ秒待機
                    , <&kp  INT5>
                    , <&kp  LANG2>;
            };
            bt0_lQWE: bt0_lQWE { // Bluetoothプロファイル0を選択し、レイヤーQWEを有効化
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to QWE &out OUT_BLE &bt BT_SEL 0 &to QWE>;
            };
            bt0_lNIC: bt0_lNIC { // Bluetoothプロファイル0を選択し、レイヤーNICを有効化
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to QWE &out OUT_BLE &bt BT_SEL 0 &to NIC>;
            };
            bt1_lNIC: bt1_lNIC { // Bluetoothプロファイル1を選択し、レイヤーNICを有効化
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to QWE &out OUT_BLE &bt BT_SEL 1 &to NIC>;
            };
            bt1_lNICL: bt1_lNICL { // Bluetoothプロファイル1を選択し、レイヤーNICLを有効化
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to QWE &out OUT_BLE &bt BT_SEL 1 &to NICL>;
            };
            bt1_lWIN: bt1_lWIN { // Bluetoothプロファイル1を選択し、レイヤーWINを有効化
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to QWE &out OUT_BLE &bt BT_SEL 1 &to WIN>;
            };
            bt2_lLIN: bt2_lLIN { // Bluetoothプロファイル2を選択し、レイヤーLINを有効化
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to QWE &out OUT_BLE &bt BT_SEL 2 &to LIN>;
            };
            bt2_lWIN: bt2_lWIN { // Bluetoothプロファイル2を選択し、レイヤーWINを有効化
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to QWE &out OUT_BLE &bt BT_SEL 2 &to WIN>;
            };
            bt2_lNICL: bt2_lNICL { // Bluetoothプロファイル2を選択し、レイヤーNICLを有効化
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to QWE &out OUT_BLE &bt BT_SEL 2 &to NICL>;
            };
            bt3_lLIN: bt3_lLIN { // Bluetoothプロファイル3を選択し、レイヤーLINを有効化
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to QWE &out OUT_BLE &bt BT_SEL 3 &to LIN>;
            };
            bt3_lCAD: bt3_lCAD { // Bluetoothプロファイル3を選択し、レイヤーCADを有効化
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to QWE &out OUT_BLE &bt BT_SEL 3 &to CAD>;
            };
            bt3_lWIN: bt3_lWIN { // Bluetoothプロファイル3を選択し、レイヤーWINを有効化
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to QWE &out OUT_BLE &bt BT_SEL 3 &to WIN>;
            };
            bt3_lNICL: bt3_lNICL { // Bluetoothプロファイル3を選択し、レイヤーNICLを有効化
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to QWE &out OUT_BLE &bt BT_SEL 3 &to NICL>;
            };
            bt4_lNIC: bt4_lNIC { // Bluetoothプロファイル4を選択し、レイヤーNICを有効化
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to QWE &out OUT_BLE &bt BT_SEL 4 &to NIC>;
            };
            bt4_lLIN: bt4_lLIN { // Bluetoothプロファイル4を選択し、レイヤーLINを有効化
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to QWE &out OUT_BLE &bt BT_SEL 4 &to LIN>;
            };
            bt4_lNICL: bt4_lNICL { // Bluetoothプロファイル4を選択し、レイヤーNICLを有効化
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to QWE &out OUT_BLE &bt BT_SEL 4 &to NICL>;
            };
            usb_lLIN: usb_lLIN { // USB接続を選択し、レイヤーLINを有効化
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to QWE &out OUT_USB &to LIN>;
            };
            usb_lCAD: usb_lCAD { // USB接続を選択し、レイヤーCADを有効化
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to QWE &out OUT_USB &to CAD>;
            };
            usb_lWIN: usb_lWIN { // USB接続を選択し、レイヤーWINを有効化
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&to QWE &out OUT_USB &to WIN>;
            };

            // =========================================================================
            // --- 2. Ctrl + A (<Key1> + Ctrl + A) ---
            // =========================================================================
            
            // Ctrl + A, A: 回転
            ctrl_a_a: ctrl_a_a {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp A>
                    ;
            };

            // Ctrl + A, B: 長方形(サイズ)
            ctrl_a_b: ctrl_a_b {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp B>
                    ;
            };

            // Ctrl + A, C: コピー
            ctrl_a_c: ctrl_a_c {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp C>
                    ;
            };

            // Ctrl + A, D: 補助線削除
            ctrl_a_d: ctrl_a_d {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp D>
                    ;
            };

            // Ctrl + A, E: 文字種別変更
            ctrl_a_e: ctrl_a_e {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp E>
                    ;
            };

            // Ctrl + A, F: 多相結線
            ctrl_a_f: ctrl_a_f {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp F>
                    ;
            };

            // Ctrl + A, G: 図形グループ化解除
            ctrl_a_g: ctrl_a_g {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp G>
                    ;
            };

            // Ctrl + A, H: 文字列置換
            ctrl_a_h: ctrl_a_h {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp H>
                    ;
            };

            // Ctrl + A, I: 連続寸法線
            ctrl_a_i: ctrl_a_i {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp I>
                    ;
            };

            // Ctrl + A, J: 図面管理情報
            ctrl_a_j: ctrl_a_j {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp J>
                    ;
            };

            // Ctrl + A, K: コメント
            ctrl_a_k: ctrl_a_k {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp K>
                    ;
            };

            // Ctrl + A, L: 直線(中心線)
            ctrl_a_l: ctrl_a_l {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp L>
                    ;
            };

            // Ctrl + A, M: 上下中央間隔揃え
            ctrl_a_m: ctrl_a_m {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp M>
                    ;
            };

            // Ctrl + A, N: 自動線番範囲選択
            ctrl_a_n: ctrl_a_n {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp N>
                    , <&macro_wait_time 80>
                    , <&macro_tap &kp TAB>
                    , <&macro_wait_time 50>
                    , <&macro_tap &kp TAB>
                    , <&macro_wait_time 50>
                    , <&macro_tap &kp TAB>
                    ;
            };

            // Ctrl + A, O: 図形要素分解
            ctrl_a_o: ctrl_a_o {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp O>
                    ;
            };

            // Ctrl + A, P: ページ編集
            ctrl_a_p: ctrl_a_p {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp P>
                    ;
            };

            // Ctrl + A, Q: 円(中心)
            ctrl_a_q: ctrl_a_q {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp Q>
                    ;
            };

            // Ctrl + A, R: Ｒ枠変更
            ctrl_a_r: ctrl_a_r {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp R>
                    ;
            };

            // Ctrl + A, S: シンボル置換
            ctrl_a_s: ctrl_a_s {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp S>
                    ;
            };

            // Ctrl + A, T: 文章
            ctrl_a_t: ctrl_a_t {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp T>
                    ;
            };

            // Ctrl + A, U: 連続寸法線削除
            ctrl_a_u: ctrl_a_u {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp U>
                    ;
            };

            // Ctrl + A, V: 貼り付け
            ctrl_a_v: ctrl_a_v {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp V>
                    ;
            };

            // Ctrl + A, W: 渡りページ編集
            ctrl_a_w: ctrl_a_w {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp W>
                    ;
            };

            // Ctrl + A, X: 範囲切断
            ctrl_a_x: ctrl_a_x {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp X>
                    ;
            };

            // Ctrl + A, Y: シンボルレイヤ変更
            ctrl_a_y: ctrl_a_y {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp Y>
                    ;
            };

            // Ctrl + A, Z: フォーマット情報
            ctrl_a_z: ctrl_a_z {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp A>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp Z>
                    ;
            };


            // =========================================================================
            // --- 3. Ctrl + D (<Key1> + Ctrl + D) ---
            // =========================================================================

            // Ctrl + D, A: 拡大・縮小
            ctrl_d_a: ctrl_d_a {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp D>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp A>
                    ;
            };

            // Ctrl + D, B: 面取り
            ctrl_d_b: ctrl_d_b {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp D>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp B>
                    ;
            };

            // Ctrl + D, C: 円弧(中心)
            ctrl_d_c: ctrl_d_c {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp D>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp C>
                    ;
            };

            // Ctrl + D, D: 補助線全削除
            ctrl_d_d: ctrl_d_d {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp D>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp D>
                    ;
            };

            // Ctrl + D, E: 文章修正
            ctrl_d_e: ctrl_d_e {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp D>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp E>
                    ;
            };

            // Ctrl + D, F: ツイスト線
            ctrl_d_f: ctrl_d_f {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp D>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp F>
                    ;
            };

            // Ctrl + D, G: 図形配列
            ctrl_d_g: ctrl_d_g {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp D>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp G>
                    ;
            };

            // Ctrl + D, H: 文字列検索
            ctrl_d_h: ctrl_d_h {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp D>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp H>
                    ;
            };

            // Ctrl + D, I: 寸法線グループ化解除
            ctrl_d_i: ctrl_d_i {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings
                    = <&macro_press &kp LCTRL>
                    , <&macro_tap &kp D>, <&macro_release &kp LCTRL>
                    , <&macro_tap &kp I>
                    ;
