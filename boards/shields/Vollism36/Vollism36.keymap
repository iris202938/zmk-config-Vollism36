            //     key-positions = <8 9>;
            //     layers = <QWE LIN CAD>;
            //     timeout-ms = <80>;
            // };
            combo_TSHIFT {
                bindings = <&qm RSHIFT>;
                key-positions = <30 35>;
                layers = <WIN NIC NICL>;            
                timeout-ms = <65>;
            };
            combo_caps_word {
                bindings = <&combo_ht_caps_word RSHIFT 0>;
                key-positions = <30 35>;
                layers = <QWE LIN CAD>;
                timeout-ms = <65>;
            };
            // combo_CAPSWORD {
            //     timeout-ms = <80>;
            //     key-positions = <20 29>;
            //     layers = <QWE LIN CAD>;
