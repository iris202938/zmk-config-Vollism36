        //         , <&macro_release &mo QWERTY>
        //         ;
        // };
        // qm: qwerty_m {
        //     compatible = "zmk,behavior-macro-one-param";
        //     wait-ms = <0>;
        //     tap-ms = <0>;
        //     #binding-cells = <1>;
        //     bindings
        //         = <&macro_press &mo QWERTY>
        //         , <&macro_param_1to1>
        //         , <&macro_press &kp MACRO_PLACEHOLDER>
        //         , <&macro_pause_for_release>
        //         , <&macro_param_1to1>
        //         , <&macro_release &kp MACRO_PLACEHOLDER>
        //         , <&macro_release &mo QWERTY>
        //         ;
        // };
        // mkp_aml: mkp_automosuelayer {
        //     compatible = "zmk,behavior-macro-one-param";
        //     #binding-cells = <1>;
        //     bindings
        //         = <&macro_param_1to1>
        //         , <&macro_press &mkp MACRO_PLACEHOLDER>
        //         , <&macro_pause_for_release>
        //         , <&macro_param_1to1>
        //         , <&macro_release &mkp MACRO_PLACEHOLDER>
        //         , <&macro_tap &sl MOV>
        //         ;
        // };
        // kp_aml: kp_automosuelayer {
        //     compatible = "zmk,behavior-macro-one-param";
        //     #binding-cells = <1>;
        //     bindings
        //         = <&macro_param_1to1>
        //         , <&macro_press &kp MACRO_PLACEHOLDER>
        //         , <&macro_pause_for_release>
        //         , <&macro_param_1to1>
        //         , <&macro_release &kp MACRO_PLACEHOLDER>
        //         , <&macro_tap &sl MOV>
        //         ;
        // };
        file_f: file_f { // ファイルの切り替え正
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp F6> // マクロキー押下時にLCTRLとF6を同時に押す
                , <&macro_release &kp LCTRL &kp F6> // マクロキー解放時にLCTRLとF6を同時に離す
                // = <&macro_press &kp LCTRL>
                // , <&macro_tap &kp F6>
                // , <&macro_release &kp LCTRL>
                ;
        };

        file_r: file_r { // ファイルの切り替え逆
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT &kp LCTRL &kp F6> // マクロキー押下時にLSHFTとLCTRLとF6を同時に押す
                , <&macro_release &kp LSHFT &kp LCTRL &kp F6> // マクロキー解放時にLSHFTとLCTRLとF6を同時に離す
                // = <&macro_press &kp LSHFT>
                // , <&macro_press &kp LCTRL>
                // , <&macro_tap &kp F6>
                // , <&macro_release &kp LCTRL>
                // , <&macro_release &kp LSHFT>
                ;
        };

        pr_pg: pr_pg { // 前ページ切り替え
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT &kp F5> // マクロキー押下時にLSHFTとF5を同時に押す
                , <&macro_release &kp LSHFT &kp F5> // マクロキー解放時にLSHFTとF5を同時に離す
                // = <&macro_press &kp LSHFT>
                // , <&macro_tap &kp F5>
                // , <&macro_release &kp LSHFT>
                ;
        };

        nx_pg: nx_pg { // 次ページ切り替え
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LSHFT &kp F6> // マクロキー押下時にLSHFTとF6を同時に押す
                , <&macro_release &kp LSHFT &kp F6> // マクロキー解放時にLSHFTとF6を同時に離す
                // = <&macro_press &kp LSHFT>
                // , <&macro_tap &kp F6>
                // , <&macro_release &kp LSHFT>
                ;
        };

        alt_right: alt_right { // フォルダ移動進む
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT &kp RIGHT>
                , <&macro_release &kp LALT &kp RIGHT>
                // = <&macro_press &kp LALT>
                // , <&macro_tap &kp RIGHT>
                // , <&macro_release &kp LALT>
                ;
        };

        alt_left: alt_left { // フォルダ移動戻る
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT &kp LEFT>
                , <&macro_release &kp LALT &kp LEFT>
                // = <&macro_press &kp LALT>
                // , <&macro_tap &kp LEFT>
                // , <&macro_release &kp LALT>
                ;
        };

        alt_up: alt_up { // フォルダ移動上
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT &kp  UP>
                , <&macro_release &kp LALT &kp UP>
                // = <&macro_press &kp LALT>
                // , <&macro_tap &kp UP>
                // , <&macro_release &kp LALT>
                ;
        };

        alt_down: alt_down { // フォルダ移動下
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LALT &kp DOWN>
                , <&macro_release &kp LALT &kp DOWN>
                // = <&macro_press &kp LALT>
                // , <&macro_tap &kp DOWN>
                // , <&macro_release &kp LALT>
                ;
        };
        ctrl_x: ctrl_x { // 切り取り
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp X>
                , <&macro_release &kp LCTRL>
                ;
        };
        ctrl_c: ctrl_c { // コピー
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp C>
                , <&macro_release &kp LCTRL>
                ;
        };


        grave_uc: grave_uc {
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press   &kp LALT>
                , <&macro_tap     &kp KP_N9 &kp KP_N6>
                , <&macro_release &kp LALT>
                ;
        };

        tilde_uc: tilde_uc {
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press   &kp LALT>
                , <&macro_tap     &kp KP_N1 &kp KP_N2 &kp KP_N6>
                , <&macro_release &kp LALT>
                ;
        };

        // to_QWE_l2: to_QWE_LANG2{
        // 	compatible = "zmk,behavior-macro";
        // 	#binding-cells = <0>;
        // 	bindings = <&to QWE>, <&kp LANG2>;
        // };

        to_QWE_i5: to_QWE_INT5{
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to QWE>, <&kp INT5>;
        };

        to_WIN_i5: to_WIN_INT5{
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to WIN>, <&kp INT5>;
        };

        to_MOV_i2: to_MOV_INT2{
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to MOV>, <&kp INT2>;
        };

        to_CAD_i2: to_CAD_INT2{
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to CAD>, <&kp INT2>;
        };

        to_NUM_i5: to_NUM_INT5{
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to NUM>, <&kp INT5>;
        };

        int5_g: int5_g { // 端点再設定(AHK)
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp INT5>
                , <&macro_wait_time 40>
                , <&macro_tap &kp G>
                , <&macro_wait_time 40>
                , <&macro_release &kp INT5>
                ;
        };	

        alt_int4: alt_int4 { // Alt+変換 選択位置移動(複写)(AHK)
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press   &kp RALT>
                , <&macro_tap     &kp INT4>
                , <&macro_release &kp RALT>
                ;
        };	

        alt_int5: alt_int5 { // Alt+無変換 選択位置移動(移動)(AHK)
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press   &kp RALT>
                , <&macro_tap     &kp INT5>
                , <&macro_release &kp RALT>
                ;
        };

        alt_slash: alt_slash { // ファイル切替 Alt+/ (AHK)
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press   &kp RALT>
                , <&macro_tap     &kp SLASH>
                , <&macro_release &kp RALT>
                ;
        };

        win_right: win_right { // デスクトップ移動進む
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_press &kp LCTRL>
                // , <&macro_wait_time 40>
                , <&macro_tap &kp RIGHT>
                // , <&macro_wait_time 40>
                , <&macro_release &kp LCTRL>
                , <&macro_release &kp LGUI>
                ;
        };

        win_left: win_left { // デスクトップ移動戻る
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_press &kp LCTRL>
                // , <&macro_wait_time 40>
                , <&macro_tap &kp LEFT>
                // , <&macro_wait_time 40>
                , <&macro_release &kp LCTRL>
                , <&macro_release &kp LGUI>
                ;
        };
        macro_INT2: macro_INT2 {
            compatible = "zmk,behavior-macro";
            label = "macro_INT2";
            #binding-cells = <0>;
            bindings = <&kp INT2>, <&to WIN>;
        };
        macro_INT5: macro_INT5 {
            compatible = "zmk,behavior-macro";
            label = "macro_INT5";
            #binding-cells = <0>;
            bindings = <&kp INT5>, <&to QWE>;
        };
        macro_LANG1: macro_LANG1 {
            compatible = "zmk,behavior-macro";
            label = "macro_LANG1";
            #binding-cells = <0>;
            bindings = <&kp LANG1>, <&to WIN>;
        };
        macro_LANG2: macro_LANG2 {
            compatible = "zmk,behavior-macro";
            label = "macro_LANG2";
            #binding-cells = <0>;
            bindings = <&kp LANG2>, <&to QWE>;
        };
        bt0_l0: bt0_l0 { // Bluetoothプロファイル0を選択し、レイヤー0を有効化
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to QWE &bt BT_SEL 0 &to QWE>;
        };
        bt1_l4: bt1_l4 { // Bluetoothプロファイル1を選択し、レイヤー4を有効化
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to QWE &bt BT_SEL 1 &to QWE>;
        };
        bt2_l4: bt2_l4 { // Bluetoothプロファイル2を選択し、レイヤー4を有効化
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to QWE &bt BT_SEL 2 &to QWE>;
        };
        bt3_l4: bt3_l4 { // Bluetoothプロファイル3を選択し、レイヤー4を有効化
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to QWE &bt BT_SEL 3 &to QWE>;
        };
        bt4_l2: bt4_l2 { // Bluetoothプロファイル4を選択し、レイヤー2を有効化
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to QWE &bt BT_SEL 4 &to QWE>;
        };
        bt4_l3: bt4_l3 { // Bluetoothプロファイル4を選択し、レイヤー3を有効化
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to QWE &bt BT_SEL 4 &to QWE>;
        };
        usb_l0: usb_l0 { // USB接続を選択し、レイヤー0を有効化
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to QWE &out OUT_USB &to QWE>;
        };
        usb_l2: usb_l2 { // USB接続を選択し、レイヤー2を有効化
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to QWE &out OUT_USB &to QWE>;
        };
        ctrl_d_x: ctrl_d_x { // 図面管理情報
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
