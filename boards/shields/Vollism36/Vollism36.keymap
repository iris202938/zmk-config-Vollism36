            combo_to_LIN {
                timeout-ms = <70>;
                key-positions = <30 35>;
                layers = <ADJ ADJL ADJW>;
                bindings = <&to LIN>;
            };
            combo_to_NUM {
                timeout-ms = <70>;
                key-positions = <30 32>;
                layers = <QWE NIC>;
                bindings = <&to NUM>;
            };
            combo_to_NUML {
                timeout-ms = <70>;
                key-positions = <30 32>;
                layers = <LIN NICL>;
                bindings = <&to NUML>;
            };
            combo_to_NUMW {
                timeout-ms = <70>;
                key-positions = <30 32>;
                layers = <CAD WIN>;
                bindings = <&to NUMW>;
            };
            combo_to_MOV {
                timeout-ms = <70>;
                key-positions = <33 35>;
                layers = <QWE NIC>;
                bindings = <&to MOV>;
            };
            combo_to_MOVL {
                timeout-ms = <70>;
                key-positions = <33 35>;
                layers = <LIN NICL>;
                bindings = <&to MOVL>;
            };
            combo_to_MOVW {
                timeout-ms = <70>;
                key-positions = <33 35>;
                layers = <CAD WIN>;
                bindings = <&to MOVW>;
