            // ng_on: ng_on {
            //     compatible = "zmk,behavior-macro";
            //     #binding-cells = <0>;
            //     bindings
            //         = <&macro_tap &kp LANGUAGE_1 &kp INTERNATIONAL_4 &to 1>
